{
  "comment": "Import mapping for DrumGizmo's DRSKit 2.1. Left/right in piece names are as seen by the drummer (as in the kit's README); stereo mics and pans are from the audience's side, to match the kit stage.",
  "matches": ["DRSKit2", "DRSKit"],
  "pack": { "id": "drumgizmo-drskit", "name": "DRSKit" },
  "variants": {
    "DRSKit_full.xml":          { "name": "DRSKit Full", "id": "drskit-full", "midimap": "Midimap_full.xml",
                                  "description": "Every articulation DRSKit was recorded with, sticks and brushes.",
                                  "tags": ["acoustic", "jazz", "rock", "brushes", "multi-mic"] },
    "DRSKit_basic.xml":         { "name": "DRSKit", "id": "drskit", "midimap": "Midimap_basic.xml", "presetOf": "DRSKit_full.xml",
                                  "description": "The kit played with sticks, with the most useful articulations.",
                                  "tags": ["acoustic", "jazz", "rock", "multi-mic"] },
    "DRSKit_minimal.xml":       { "name": "DRSKit Minimal", "id": "drskit-minimal", "midimap": "Midimap_minimal.xml", "presetOf": "DRSKit_full.xml",
                                  "description": "The fewest articulations: quick to load and simple to play.",
                                  "tags": ["acoustic", "rock", "multi-mic"] },
    "DRSKit_no_whiskers.xml":   { "name": "DRSKit No Brushes", "id": "drskit-no-brushes", "midimap": "Midimap_no_whiskers.xml", "presetOf": "DRSKit_full.xml",
                                  "description": "Every stick articulation, without the brushes.",
                                  "tags": ["acoustic", "jazz", "rock", "multi-mic"] },
    "DRSKit_whiskers_only.xml": { "name": "DRSKit Brushes", "id": "drskit-brushes", "midimap": "Midimap_whiskers_only.xml", "presetOf": "DRSKit_full.xml",
                                  "preferArticulations": ["brush", "closed_brush", "open_brush"],
                                  "description": "The kit played with brushes.",
                                  "tags": ["acoustic", "jazz", "brushes", "multi-mic"] }
  },
  "author": "The DrumGizmo team (Deva and Lars Muldjord) with Jes Eiler of DRSDrums",
  "levelDb": -6,
