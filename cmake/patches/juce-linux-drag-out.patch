-    ::Window externalFindDragTargetWindow (::Window target)
+    /*  The XdndAware window under the pointer, or None.
+
+        On a plain X server, XQueryPointer's child chain leads to it. Under
+        XWayland it doesn't: once the pointer leaves this app's own windows,
+        XWayland reports no child at all, even over another X11 app. So when
+        the child chain finds nothing, the window is picked from the pointer's
+        position and the stacking order instead (as GTK and Qt do), and failing
+        that the compositor's drop proxy is used (see findCompositorDropProxy).
+    */
+    ::Window externalFindDragTargetWindow()
+    {
+        auto* display = getDisplay();
+        auto* x11 = X11Symbols::getInstance();
+        const auto root = x11->xRootWindow (display, x11->xDefaultScreen (display));
+
+        ::Window rootReturn = None, child = None;
+        int rootX = 0, rootY = 0, winX = 0, winY = 0;
+        unsigned int mask = 0;
+
+        if (! x11->xQueryPointer (display, root, &rootReturn, &child, &rootX, &rootY, &winX, &winY, &mask))
+            return None;
+
+        if (const auto w = findAwareAlongPointer (child); w != None)
+            return w;
+
+        if (const auto w = findAwareAt (root, 0, 0, rootX, rootY); w != None)
+            return w;
+
+        return findCompositorDropProxy (root);
+    }
+
+    ::Window findAwareAlongPointer (::Window target)
     {
         if (target == None)
