@@ -562,7 +635,100 @@ private:
 
         X11Symbols::getInstance()->xQueryPointer (getDisplay(), target, &phonyWin, &child, &phony, &phony, &phony, &phony, &uphony);
 
-        return externalFindDragTargetWindow (child);
+        return findAwareAlongPointer (child);
+    }
+
+    /*  Looks through parent's children, topmost first, for the viewable one
+        containing (x, y) in root coordinates; (originX, originY) is parent's
+        own origin in root coordinates. Returns that window if it's XdndAware,
+        else whatever this finds inside it. Input-only windows that aren't
+        XdndAware (and have nothing aware inside) are looked through, since
+        they draw nothing the user could be aiming at.
+    */
+    ::Window findAwareAt (::Window parent, int originX, int originY, int x, int y, int depth = 0)
+    {
+        if (depth > 16)
+            return None;
+
+        auto* display = getDisplay();
+        auto* x11 = X11Symbols::getInstance();
+
+        ::Window rootReturn = None, parentReturn = None;
+        ::Window* children = nullptr;
+        unsigned int numChildren = 0;
+
+        if (! x11->xQueryTree (display, parent, &rootReturn, &parentReturn, &children, &numChildren) || children == nullptr)
+            return None;
+
+        ::Window result = None;
+
+        for (auto i = (int) numChildren; --i >= 0;)
+        {
+            XWindowAttributes attr;
+
+            if (! x11->xGetWindowAttributes (display, children[i], &attr) || attr.map_state != IsViewable)
+                continue;
+
+            const auto left = originX + attr.x + attr.border_width;
+            const auto top  = originY + attr.y + attr.border_width;
+
+            if (! Rectangle<int> (left, top, attr.width, attr.height).contains (x, y))
+                continue;
+
+            if (isWindowDnDAware (children[i]))
+            {
+                result = children[i];
+                break;
+            }
+
+            result = findAwareAt (children[i], left, top, x, y, depth + 1);
+
+            if (result != None || attr.c_class != InputOnly)
+                break;
+        }
+
+        x11->xFree (children);
+        return result;
+    }
+
+    /*  Under Wayland, the compositor bridges X11 drags to Wayland apps by
+        mapping an input-only, override-redirect, XdndAware window of its own
+        over the Wayland surface under the pointer, and passing on what it's
+        sent. It only maps that window while the pointer is over a Wayland
+        surface, but it may not be where findAwareAt looks for it: with display
+        scaling, GNOME places it in logical rather than X11 coordinates. So if
+        nothing is found under the pointer and such a window is showing, it's
+        the target.
+    */
+    ::Window findCompositorDropProxy (::Window root)
+    {
+        auto* display = getDisplay();
+        auto* x11 = X11Symbols::getInstance();
+
+        ::Window rootReturn = None, parentReturn = None;
+        ::Window* children = nullptr;
+        unsigned int numChildren = 0;
+
+        if (! x11->xQueryTree (display, root, &rootReturn, &parentReturn, &children, &numChildren) || children == nullptr)
+            return None;
+
+        ::Window result = None;
+
+        for (auto i = (int) numChildren; --i >= 0 && result == None;)
+        {
+            XWindowAttributes attr;
+
+            if (children[i] != windowH
+                && x11->xGetWindowAttributes (display, children[i], &attr)
+                && attr.map_state == IsViewable
+                && attr.override_redirect
+                && attr.c_class == InputOnly
+                && isWindowDnDAware (children[i]))
+                result = children[i];
+        }
+
+        x11->xFree (children);
+        return result;
     }
 
